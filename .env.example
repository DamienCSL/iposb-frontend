# Laravel API (iposb-api). Vite proxies /api → this origin when VITE_API_URL is empty
VITE_API_ORIGIN=http://127.0.0.1:8000

# JSON API base. Empty = use Vite proxy /api → Laravel (recommended for npm run dev).
# For npm run preview / production builds, set e.g.:
# VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_URL=

# Only attached to /dispatch/* (and /ops/scan, /demo/*). Ops/admin use office Bearer.
VITE_DISPATCH_KEY=iposb-dispatch-dev-key

# Optional: if Laravel login fails, allow local DEMO_USERS (dev only). Default off.
# VITE_ALLOW_DEMO_LOGIN=true
