# Legacy PHP FMS (open-in-legacy links)
VITE_LEGACY_URL=http://localhost:8080

# Laravel API (iposb-api). Vite proxies /api → this origin when VITE_API_URL is empty
VITE_API_ORIGIN=http://127.0.0.1:8000

# JSON API origin. Empty = use Vite proxy /api → Laravel
VITE_API_URL=

# Ops dispatch endpoints (must match DISPATCH_API_KEY in iposb-api)
VITE_DISPATCH_KEY=iposb-dispatch-dev-key
