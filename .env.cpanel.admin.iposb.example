# FMS build env for admin.iposb.com.my (single-host deploy)
# Copy to .env.production.local before npm run build
# Or use: prepare-cpanel-deploy.ps1 -SingleHost "https://admin.iposb.com.my"

# Same host — relative API path (no second subdomain needed)
VITE_API_URL=/api
VITE_DISPATCH_KEY=IPOSB_dispatch
VITE_ALLOW_DEMO_LOGIN=false
