# Used when building the FMS for cPanel (npm run build).
# Copy to .env.production.local or pass vars to prepare-cpanel-deploy.ps1

# Laravel API public URL (must include /api)
VITE_API_URL=https://api.YOUR_DOMAIN.com/api

# Must match DISPATCH_API_KEY in the API .env (for dispatch scan routes only)
VITE_DISPATCH_KEY=IPOSB_dispatch

# Leave empty in production — demo login is dev-only
# VITE_ALLOW_DEMO_LOGIN=false
