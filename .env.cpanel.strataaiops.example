# FMS build env for iposb.strataaiops.com (single-host deploy)
# Copy to .env.production.local before npm run build
# Or use: prepare-cpanel-deploy.ps1 -SingleHost "https://iposb.strataaiops.com"

# Same host — relative API path (no second subdomain needed)
VITE_API_URL=/api
VITE_DISPATCH_KEY=IPOSB_dispatch
